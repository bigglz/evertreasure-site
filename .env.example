# ============================================================
# 환경 변수 설정 파일
#
# 사용법:
#   1) 이 파일을 복사해서 같은 위치에 ".env.local" 이라는 이름으로 저장하세요.
#      (터미널:  cp .env.example .env.local)
#   2) 아래 값들을 실제 값으로 채워 넣으세요.
#   3) .env.local 은 절대 Git에 커밋하지 마세요. (.gitignore에 이미 등록되어 있음)
#
# 참고: NEXT_PUBLIC_ 으로 시작하는 변수는 브라우저에 노출됩니다.
#       Web3Forms 액세스 키는 공개되어도 무방하도록 설계된 키입니다.
# ============================================================

# ------------------------------------------------------------
# [필수] Web3Forms 액세스 키 — 문의(Contact) 폼 이메일 발송에 사용
#
# 발급 방법 (1분 소요, 회원가입 불필요):
#   1) https://web3forms.com 접속
#   2) "Create your Access Key" 에 문의 메일을 받을 이메일 주소 입력
#   3) 메일로 도착한 Access Key를 아래에 붙여넣기
#
# 문의 폼으로 접수된 내용은 위에서 입력한 이메일 주소로 발송됩니다.
# 무료 플랜: 월 250건
# ------------------------------------------------------------
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=여기에_발급받은_액세스_키_입력

# ------------------------------------------------------------
# [선택] 사이트 대표 URL — 오픈그래프(카카오톡/SNS 공유 미리보기) 이미지 절대경로 생성에 사용
# 실제 배포 도메인으로 변경하세요. (마지막에 / 없이)
#
# 참고: 캐릭터별 도메인 5개가 같은 빌드를 공유하므로 이 값은 하나만 지정합니다.
#       대표 도메인 하나를 적어두면 5개 도메인 모두에서 공유 미리보기가 정상 동작합니다.
#       (og:image 의 호스트만 이 값으로 고정됩니다)
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://evertreasure-bella.bigglz.com

# ------------------------------------------------------------
# ⚠ NEXT_PUBLIC_BASE_PATH 는 여기에 설정하지 마세요.
#   GitHub Pages 처럼 /저장소명/ 하위 경로에 배포할 때만 필요한 값이며,
#   자체 도메인(도커 배포)에서 설정하면 모든 이미지·CSS 경로가 404 가 됩니다.
#   GitHub Pages 배포 시에는 워크플로가 자동으로 주입합니다.
# ------------------------------------------------------------
