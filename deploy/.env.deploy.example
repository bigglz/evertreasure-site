# deploy/.env.deploy 로 복사해서 사용하세요 (git에 커밋되지 않습니다).
#   cp deploy/.env.deploy.example deploy/.env.deploy

# 배포 서버 접속 정보
SSH_HOST=ethan@서버주소
SSH_PORT=22

# 서버에서 이 저장소의 deploy/ 파일과 이미지 아카이브가 놓이는 경로
REMOTE_DIR=/opt/evertreasure

# 서버가 x86_64 면 linux/amd64, ARM 이면 linux/arm64
# (build-and-package.sh 가 읽습니다)
PLATFORM=linux/amd64

# 서버에 남겨둘 과거 아카이브 수 (롤백용)
KEEP=3

# docker 명령. 서버에서 sudo 없이 docker 가 되면 그대로 두세요.
# 안 되면 (docker 그룹 미가입) 주석을 해제하세요.
# DOCKER="sudo docker"
